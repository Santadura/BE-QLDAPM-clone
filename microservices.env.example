# Copy the following names into .env and replace every value before deployment.
# docker compose reads .env automatically; never commit your real .env file.
# Values below are examples, not production secrets.
CORE_DB_PASSWORD=replace-with-a-unique-core-database-password
AUDIT_DB_PASSWORD=replace-with-an-independent-audit-database-password
AUDIT_INTERNAL_API_KEY=replace-with-a-long-random-internal-service-key
JWT_SECRET=replace-with-a-long-random-jwt-signing-key-at-least-32-bytes
JWT_EXPIRATION_MS=86400000
CATALOG_DB_PASSWORD=replace-with-an-independent-catalog-database-password
CATALOG_INTERNAL_API_KEY=replace-with-an-independent-catalog-service-key
GATEWAY_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
