# Spring Boot database connection
# Local Docker defaults:
DB_URL=jdbc:postgresql://localhost:5432/qlapm_db
DB_USERNAME=giakiet
DB_PASSWORD=201205

# Prisma connection
# Local:
DATABASE_URL=postgresql://giakiet:201205@localhost:5432/qlapm_db?schema=public
DIRECT_URL=postgresql://giakiet:201205@localhost:5432/qlapm_db?schema=public

# Supabase example:
# DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# DB_USERNAME=postgres
# DB_PASSWORD=<your-database-password>
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
#
# Keep secrets only in your local .env / deployment environment. Never commit real passwords.

JWT_SECRET=change-this-to-a-long-random-secret-key-at-least-256-bits-please
JWT_EXPIRATION_MS=86400000

# Work assistant: guide mode works without an API key.
# Enable AI only on the backend. Never put this key in VITE_* variables.
CHAT_AI_ENABLED=false
CHAT_AI_PROVIDER=gemini
GEMINI_API_KEY=
# Leave model empty to select the provider default.
CHAT_AI_MODEL=
# Only used when CHAT_AI_PROVIDER=openai
OPENAI_API_KEY=


# Social login: keep all provider secrets on the backend only.
SOCIAL_FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_API_VERSION=v26.0
# Set true with HTTPS in production.
SESSION_COOKIE_SECURE=false

# Payment sandbox: get your own merchant keys; never expose these with VITE_*.
PAYMENT_SANDBOX=true
PAYMENT_FRONTEND_URL=http://localhost:5173
# Public HTTPS origin forwarding /api to backend (required for provider IPN).
PAYMENT_PUBLIC_API_URL=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
# Optional MoMo URLs. Defaults use sandbox/production, frontend and public API above.
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:5173/api/payments/momo/return
# Public HTTPS URL ending in /api/payments/momo/ipn. Leave blank to use PAYMENT_PUBLIC_API_URL.
MOMO_IPN_URL=
